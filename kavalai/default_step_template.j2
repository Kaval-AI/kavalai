[PLANNING DATA]
current_step={{ current_step }}
max_steps={{ max_steps }}

[STEPS EXECUTED SO FAR]
{% if steps %}
{% for step in steps %}
Step {{ step.index }}:
{% if step.instructions %}
  goal: {{ step.instructions }}
{% endif %}
{% for call in step.tool_calls %}
  - {{ call.name }}(call_id={{ call.call_id }}) args={{ call.args }}
    output: {{ call.output }}
{% endfor %}
{% if step.output is not none %}
  output: {{ step.output }}
{% endif %}
{% endfor %}
{% else %}
(none yet)
{% endif %}

Analyze the situation and provide the next step output.
