# Kaval.AI environment template.
#
# Copy to `.env` and fill in. Every name below is read by code somewhere under
# `kavalai/` — nothing here is decorative. Library modules never read the
# environment themselves; only entry points (`__main__`, `run_agent_server`,
# `migrate_db`) do, so anything you see here configures a process, not a class.

#########################
# COMMON — providers
#########################

# OpenAI. Used by the LLM client and the OpenAI embedding provider.
OPENAI_API_KEY=fakekey
# Optional: "flex", "priority", … Passed through to the Responses API.
KAVALAI_OPENAI_SERVICE_TIER=standard

# Google Gemini. Used by the LLM client and the Gemini embedding provider.
GEMINI_API_KEY=

# Anthropic. NB: the client reads ANTHROPIC_API_KEY, not ANTHROPIC_KEY.
ANTHROPIC_API_KEY=

# Ollama. The scheme is optional — the SDK prepends http:// when it is missing.
OLLAMA_HOST=localhost:11434

# Defaults used when a workflow or tool does not name a model itself.
# Both take the `provider/model` form.
KAVALAI_DEFAULT_LLM_MODEL=openai/gpt-5-nano-2025-08-07
KAVALAI_DEFAULT_EMBEDDING_MODEL=openai/text-embedding-3-small
#KAVALAI_DEFAULT_EMBEDDING_MODEL=ollama/nomic-embed-text-v2-moe

# Optional YAML describing embedding text normalisation rules.
KAVALAI_EMBEDDING_NORMALIZER_YAML=

# Name of a registered RAG service for `python -m kavalai.tools.index_csv` to
# index into. Leave empty for the Postgres service built from KAVALAI_DB_URI.
KAVALAI_RAG_SERVICE=

# FastEmbed (local, no API key). Model files are downloaded on first use.
FASTEMBED_CACHE_DIR=
FASTEMBED_THREADS=

# Echo every SQL statement. Useful when debugging migrations; noisy otherwise.
KAVALAI_SQL_ECHO=0

#########################
# BACKOFFICE
#########################

# Google OAuth credentials for backoffice sign-in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Signing key for backoffice session cookies. Set this in production — the
# fallback is a well-known development value.
SESSION_SECRET_KEY=

# Where the Angular frontend is served from; used for redirects and CORS.
FRONTEND_URL=http://localhost:4200

# Where `python -m kavalai.backoffice.server` binds.
KAVALAI_BO_HOST=0.0.0.0
KAVALAI_BO_PORT=10888

# The backoffice's own database (projects, users, memberships).
KAVALAI_BO_DB_URI=postgresql://kavalai_dev:kavalai_dev@localhost:14000/kavalai_dev
KAVALAI_BO_DB_SCHEMA=backoffice

#########################
# AGENT SERVER
#########################

# The agent runtime database (agents, sessions, runs, tasks, model call stats).
KAVALAI_DB_URI=postgresql://kavalai_dev:kavalai_dev@localhost:14000/kavalai_dev
KAVALAI_DB_SCHEMA=agents
KAVALAI_DB_POOL_SIZE=0
KAVALAI_DB_MAX_OVERFLOW=0

# The workflow `python -m kavalai.server` serves.
KAVALAI_AGENT_WORKFLOW_PATH=examples/v2_workflow_support_agent.yaml
# Imported before the workflow is loaded: registers the python:// tools and the
# named RAG services it refers to. A dotted module name, or a path to a .py
# file. Needed by any workflow whose rag_query node names a registered service.
# For the shipped examples: examples/green_village/eval_setup.py
KAVALAI_AGENT_SETUP_MODULE=

# Modules imported before the workflow loads, so any custom LLM, embedding or
# RAG backends they register are resolvable from the YAML. Comma-separated
# dotted module names; each is expected to call register_llm_provider(),
# register_embedding_provider() or register_rag_service() at import.
KAVALAI_PROVIDER_MODULES=

# Where the agent server binds.
KAVALAI_AGENT_HOST=0.0.0.0
KAVALAI_AGENT_PORT=10000

# HTTP basic auth. Leave both empty to disable it — note that this also leaves
# GET /workflow open, which returns the full workflow definition.
KAVALAI_AGENT_BASIC_AUTH_USER=user
KAVALAI_AGENT_BASIC_AUTH_PASSWORD=pass

#########################
# TOOLS
#########################

# Web search. The bundled search tools use one of these; the key-free
# DuckDuckGo scraper in `webtools/crawl4ai.py` needs neither.
LANGSEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
# Programmable Search Engine id, required alongside the Google key.
GOOGLE_CUSTOM_SEARCH_CX=

# Basic auth for the bundled RSS tool's own endpoints. Defaults to
# admin/password when unset — change both before running it anywhere real.
RSS_AUTH_USER=
RSS_AUTH_PASSWORD=

#########################
# PROXY
#########################

# The bundled HTTP tool can route through a Tor/Privoxy proxy (the `torproxy`
# service in docker-compose.yml). Only used when a tool asks for it.
TOR_PROXY_HOST=localhost
TOR_PROXY_PORT=8118
