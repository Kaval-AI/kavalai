# Kaval.AI environment template.
#
# Copy to `.env` and fill in. Every name below is read by code under
# `kavalai/` — nothing here is decorative — except the two marked "SDK",
# which the provider SDK reads itself. Library code takes its configuration
# as arguments; only the processes read the environment (`python -m
# kavalai.server`, `python -m kavalai.migrate_db`, `kavalai-eval`, the
# backoffice), and the provider clients fall back to their SDK's own key
# variable. Anything you see here therefore configures a process, not a class.
# `tests/test_config_drift.py` checks this file against the code in both
# directions, and that no other module reads the environment.

#########################
# COMMON — providers
#########################

# OpenAI. Used by the LLM client and the OpenAI embedding provider.
OPENAI_API_KEY=
# SDK: the OpenAI SDK honours this when no base_url is passed — the way to
# point openai/… models at a proxy or an OpenAI-compatible endpoint.
OPENAI_BASE_URL=

# Google Gemini. Used by the LLM client and the Gemini embedding provider.
GEMINI_API_KEY=
# SDK: google-genai also accepts GOOGLE_API_KEY, and prefers it when both are
# set. Kaval.AI itself reads only GEMINI_API_KEY.
GOOGLE_API_KEY=

# Anthropic. NB: the client reads ANTHROPIC_API_KEY, not ANTHROPIC_KEY.
ANTHROPIC_API_KEY=

# Ollama. No key needed.
OLLAMA_HOST=http://localhost:11434

#########################
# COMMON — models
#########################

# Read by the agent server and passed to the engine as default_llm_model: the
# model used when a workflow and its nodes do not name one, as `provider/model`.
KAVALAI_DEFAULT_LLM_MODEL=openai/gpt-5.4-mini

# Fleet-wide defaults for every model call, read by the agent server and the
# eval runner's judge and passed to the engine as default_llm_parameters. A
# node's or graph's llm_kwargs override them: node > graph > these > provider
# defaults. Leave a value empty to let the provider decide.
KAVALAI_LLM_TEMPERATURE=
KAVALAI_LLM_TOP_P=
KAVALAI_LLM_REASONING_EFFORT=
KAVALAI_LLM_SERVICE_TIER=
# Seconds before a model call is abandoned; the streaming timeout defaults to
# twice the plain one.
KAVALAI_LLM_TIMEOUT_SECONDS=
KAVALAI_LLM_STREAM_TIMEOUT_SECONDS=

# Optional YAML describing embedding text normalisation rules. Read by the
# agent server and the index_csv example and applied with
# set_default_normalizer.
KAVALAI_EMBEDDING_NORMALIZER_YAML=

# FastEmbed (local, no API key). Model files are downloaded on first use.
FASTEMBED_CACHE_DIR=
FASTEMBED_THREADS=

# Echo every SQL statement. Useful when debugging migrations; noisy otherwise.
KAVALAI_SQL_ECHO=0

#########################
# BACKOFFICE
#########################

# Google OAuth client for backoffice sign-in. Required: the backoffice refuses
# to start without both.
KAVALAI_BO_GOOGLE_CLIENT_ID=
KAVALAI_BO_GOOGLE_CLIENT_SECRET=

# Signing key for backoffice session cookies. Required, no fallback: the
# backoffice refuses to start without it.
KAVALAI_BO_SESSION_SECRET_KEY=

# Where a completed sign-in is redirected to: the Angular dev server from a
# checkout, the backoffice itself when Nginx serves the compiled front end.
KAVALAI_BO_FRONTEND_URL=http://localhost:4200

# Where `python -m kavalai.backoffice.server` binds. The container's Nginx
# proxies to 127.0.0.1:8000 and Compose loads this file, so keep the port.
KAVALAI_BO_HOST=127.0.0.1
KAVALAI_BO_PORT=8000

# The backoffice's own database (projects, users, memberships).
KAVALAI_BO_DB_URI=postgresql://kavalai_dev:kavalai_dev@localhost:6543/kavalai_dev
KAVALAI_BO_DB_SCHEMA=backoffice

#########################
# AGENT SERVER
#########################

# The agent runtime database (agents, sessions, runs, tasks, model call stats).
KAVALAI_DB_URI=postgresql://kavalai_dev:kavalai_dev@localhost:6543/kavalai_dev
KAVALAI_DB_SCHEMA=agents
KAVALAI_DB_POOL_SIZE=0
KAVALAI_DB_MAX_OVERFLOW=0

# The workflow `python -m kavalai.server` serves.
KAVALAI_AGENT_WORKFLOW_PATH=examples/support_agent/support_agent.yaml
# Imported before the workflow is loaded: registers the python:// tools and the
# named RAG services it refers to. A dotted module name, or a path to a .py
# file. Needed by any workflow whose rag_query node names a registered service.
# Example: myapp/agent_setup.py
KAVALAI_AGENT_SETUP_MODULE=

# Modules imported before the workflow loads, so any custom LLM, embedding or
# RAG backends they register are resolvable from the YAML. Comma-separated
# dotted module names; each is expected to call register_llm_provider(),
# register_embedding_provider() or register_rag_service() at import.
KAVALAI_PROVIDER_MODULES=

# Where the agent server binds.
KAVALAI_AGENT_HOST=0.0.0.0
KAVALAI_AGENT_PORT=10000

# HTTP basic auth. Leave both empty to disable it — note that this also leaves
# GET /workflow open, which returns the full workflow definition.
KAVALAI_AGENT_BASIC_AUTH_USER=
KAVALAI_AGENT_BASIC_AUTH_PASSWORD=

#########################
# PROXY
#########################

# The bundled HTTP tool can route through a Tor/Privoxy proxy (the `torproxy`
# service in docker-compose.yml). Only used when a tool asks for it.
KAVALAI_TOR_PROXY_HOST=localhost
KAVALAI_TOR_PROXY_PORT=8118
